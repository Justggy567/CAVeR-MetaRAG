{
  "dataset": {
    "name": "ASQA-top5-76",
    "path": "data/frozen/asqa_top5_76_cleaned_final.json",
    "format": "paired_answers",
    "answer_roles": "both"
  },
  "prepared_path": "artifacts/prepared/asqa_top5_76.probes.jsonl",
  "resume": true,
  "decomposition_format_max_attempts": 3,
  "decomposition_failure_policy": "record_and_continue",
  "mutation_temperature": 0.2,
  "mutation_format_max_attempts": 3,
  "mutation_failure_policy": "record_and_continue",
  "preparation_model": {
    "backend": "openai_compatible",
    "model_id": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.0,
    "top_p": 1.0,
    "max_tokens": 4096,
    "seed": null,
    "thinking_mode": "disabled",
    "timeout_seconds": 120,
    "max_retries": 4
  }
}
